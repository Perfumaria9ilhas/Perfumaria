generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  active       Boolean  @default(false)
  sessionVersion Int    @default(0)
  lastLoginAt  DateTime?
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CustomerAccount {
  id         String   @id @default(cuid())
  role       AccountRole @default(CUSTOMER)
  active     Boolean @default(true)
  sessionVersion Int @default(0)
  lastLoginAt DateTime?
  deletionRequestedAt DateTime?
  firstName  String
  lastName   String
  email      String   @unique
  passwordHash String?
  phone      String
  address    String
  orders     SiteOrder[]
  favorites  CustomerFavorite[]
  passwordResets CustomerPasswordReset[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CustomerPasswordReset {
  id String @id
  customerId String
  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  sessionVersion Int
  createdAt DateTime @default(now())
  @@index([customerId, createdAt])
}

model CustomerAuthThrottle {
  id String @id
  count Int
  expiresAt DateTime
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  origin    String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductType {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String
  inspiredBy       String?
  durationLabel    String?
  sizeLabel        String            @default("100 ml")
  imageUrl         String
  priceInCents     Int
  salePriceInCents Int?
  stock            Int
  purchaseCostInCents Int           @default(0)
  lowStockAlert    Int               @default(3)
  stockNotes       String?
  audience         ProductAudience   @default(UNISSEXO)
  concentration    ProductConcentration @default(EDP)
  availableInFiveMl Boolean          @default(true)
  availableInTenMl  Boolean          @default(false)
  active           Boolean           @default(true)
  featured         Boolean           @default(false)
  homeFeatured     Boolean           @default(false)
  bestseller       Boolean           @default(false)
  brandId          String
  categoryId       String
  productTypeId    String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  brand            Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productType      ProductType       @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  wishes           OutOfStockWish[]
  orderItems       SiteOrderItem[]
  stockMovements   StockMovement[]
  analyticsDaily   ProductAnalyticsDaily[]
  promotion        ProductPromotion?
  favorites        CustomerFavorite[]

  @@index([brandId])
  @@index([categoryId])
  @@index([productTypeId])
}

enum ProductAudience {
  FEMININO
  MASCULINO
  UNISSEXO
}

enum ProductConcentration {
  EDT
  EDP
  PARFUM
  EXTRAIT
  ELIXIR
}

model SiteOrder {
  id                String           @id @default(cuid())
  reference         String           @unique
  source            String           @default("site")
  status            String           @default("novo")
  customerAccountId String?
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  customerAddress   String?
  totalInCents      Int
  whatsappMessage   String
  items             SiteOrderItem[]
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([createdAt])
  @@index([status])
}

model SiteOrderItem {
  id            String    @id @default(cuid())
  orderId       String
  productId     String?
  productName   String
  brandName     String
  unitPriceInCents Int
  quantity      Int
  lineTotalInCents Int
  order         SiteOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([orderId])
}

model OutOfStockWish {
  id        String   @id @default(cuid())
  productId String   @unique
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([attempts])
}

model StoreSettings {
  id               String   @id
  homepageConfig   Json     @default("{}")
  storeName        String
  heroTitle        String
  heroDescription  String
  heroPrimaryButtonLabel String @default("Ver Catálogo")
  heroSecondaryButtonLabel String @default("Sobre Nós")
  heroBenefitOne   String   @default("Perfumes 100% Originais")
  heroBenefitTwo   String   @default("Entrega rápida na Ilha Terceira")
  heroBenefitThree String   @default("Atendimento personalizado por WhatsApp")
  heroBenefitFour  String   @default("Amostras disponíveis em 5ml")
  heroImageUrl     String?
  heroMaleImageUrl String?
  heroFemaleImageUrl String?
  heroUnisexImageUrl String?
  decantsImageUrl  String?
  heroSlides       HeroSlide[]
  homeFeaturedEyebrow String @default("Mais vendidos")
  homeFeaturedTitle String @default("Os Preferidos dos Nossos Clientes")
  homeFeaturedDescription String @default("As fragrâncias mais procuradas e recomendadas pelos nossos clientes.")
  homeFeaturedButtonLabel String @default("Ver todos")
  homeDecantsEyebrow String @default("Serviço complementar")
  homeDecantsTitle String @default("Experimente antes de comprar")
  homeDecantsDescription String @default("Decants de 5ml e 10ml disponíveis em perfumes selecionados.")
  homeDecantsButtonLabel String @default("Ver Decants")
  homeWhyChooseEyebrow String @default("Confiança")
  homeWhyChooseTitle String @default("Porque Comprar na Perfumaria 9 Ilhas?")
  whyChooseItemOneTitle String @default("Entrega rápida na Ilha Terceira")
  whyChooseItemOneText String @default("Receba com rapidez e acompanhamento próximo.")
  whyChooseItemTwoTitle String @default("Envio para Açores, Madeira e Portugal Continental")
  whyChooseItemTwoText String @default("Preparamos cada encomenda com atenção e segurança.")
  whyChooseItemThreeTitle String @default("Perfumes 100% Originais")
  whyChooseItemThreeText String @default("Selecionamos referências autênticas e confiáveis.")
  whyChooseItemFourTitle String @default("Atendimento via WhatsApp")
  whyChooseItemFourText String @default("Respondemos de forma próxima e personalizada.")
  whyChooseItemFiveTitle String @default("Pagamento Seguro")
  whyChooseItemFiveText String @default("Confirmação clara antes de finalizar a encomenda.")
  homeTestimonialsEyebrow String @default("Testemunhos")
  homeTestimonialsTitle String @default("O que dizem os nossos clientes")
  catalogTitle     String
  catalogIntro     String
  contactTitle     String
  contactIntro     String
  footerDescription String
  location         String
  phone            String
  whatsappNumber   String
  whatsappLabel    String
  openingHours     String
  contactEmail     String?
  instagramUrl     String?
  facebookUrl      String?
  tiktokUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model HeroSlide {
  id              String        @id @default(cuid())
  imageUrl        String
  position        Int
  durationSeconds Int           @default(4)
  storeSettingsId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  storeSettings   StoreSettings @relation(fields: [storeSettingsId], references: [id], onDelete: Cascade)

  @@unique([storeSettingsId, position])
  @@index([storeSettingsId, position])
}

model StoreReview {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  comment   String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved, createdAt])
}

model StoreMetric {
  id                      String   @id
  totalSatisfiedCustomers Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model DailySiteVisit {
  id         String   @id @default(cuid())
  dateKey    String   @unique
  visitCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dateKey])
}

model AnalyticsDaily {
  id                      String   @id @default(cuid())
  dateKey                 String   @unique
  visits                  Int      @default(0)
  productViews            Int      @default(0)
  addToCartEvents         Int      @default(0)
  addedUnits              Int      @default(0)
  checkoutWhatsapp        Int      @default(0)
  reservations            Int      @default(0)
  generalWhatsappContacts Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([dateKey])
}

model ProductAnalyticsDaily {
  id                String   @id @default(cuid())
  dateKey           String
  productId         String
  views             Int      @default(0)
  addToCartEvents   Int      @default(0)
  addedUnits        Int      @default(0)
  checkoutEvents    Int      @default(0)
  checkoutUnits     Int      @default(0)
  reservationEvents Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([dateKey, productId])
  @@index([dateKey])
  @@index([productId, dateKey])
}

model SearchAnalyticsDaily {
  id               String   @id @default(cuid())
  dateKey          String
  normalizedTerm   String
  displayTerm      String
  searchCount      Int      @default(0)
  resultCountTotal Int      @default(0)
  zeroResultCount  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([dateKey, normalizedTerm])
  @@index([dateKey])
  @@index([normalizedTerm, dateKey])
}

model StoredImage {
  id          String   @id @default(cuid())
  fileName    String   @unique
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StockMovement {
  id                String            @id @default(cuid())
  productId         String
  type              StockMovementType
  reason            StockMovementReason?
  customerName      String?
  saleGroupId       String?
  saleStatus        StockSaleStatus?
  deliveryStatus    StockDeliveryStatus?
  saleOrigin        String?
  saleUnitPriceInCents Int?
  quantity          Int
  previousStock     Int
  resultingStock    Int
  unitCostInCents   Int?
  supplier          String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([saleGroupId])
  @@index([saleStatus, createdAt])
}

enum StockSaleStatus {
  PENDING
  PAID
  OFFERED
}

enum StockDeliveryStatus {
  DELIVERED
  PENDING
}

enum StockMovementType {
  ENTRY
  SALE
  ADJUSTMENT
}

enum StockMovementReason {
  SALE
  GIFT
  LOSS
  DECANT
  INTERNAL_USE
  OTHER
  MANUAL
}

// Device subscriptions belong to the authenticated JWT administrator, including
// the existing configured-admin identity (which has no AdminUser row).
model AdminPushSubscription {
  id                   String   @id @default(cuid())
  adminId              String
  endpoint             String   @unique
  p256dh               String
  auth                 String
  payments             Boolean  @default(true)
  deliveries           Boolean  @default(true)
  stock                Boolean  @default(true)
  lastAlertFingerprint String?
  lastTestAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@index([adminId])
}

enum AccountRole {
  CUSTOMER
  ADMIN
}

// Security metadata, not a second user directory. The existing configured
// authentication subject is pinned and cannot be changed by the application.
model AccountSecurity {
  id String @id
  principalId String @unique
  createdAt DateTime @default(now())
}

model AccountAudit {
  id String @id @default(cuid())
  actorId String
  targetId String
  targetKind String
  action String
  previous Json?
  next Json?
  createdAt DateTime @default(now())
  @@index([targetId, createdAt])
}

enum PromotionMethod {
  PERCENT
  FIXED
}

enum PromotionStatus {
  ENABLED
  DISABLED
  ENDED
}

// One normal promotion per product. Revisions are retained in PromotionAudit.
model ProductPromotion {
  id String @id @default(cuid())
  productId String @unique
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  method PromotionMethod
  value Int // hundredths of a percent, or integer euro cents
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime? @db.Timestamptz(3)
  status PromotionStatus @default(ENABLED)
  actorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startsAt, endsAt])
}

model PromotionAudit {
  id String @id @default(cuid())
  promotionId String
  productId String
  actorId String
  action String
  previous Json?
  next Json?
  createdAt DateTime @default(now())
  @@index([productId, createdAt])
}

model CustomerFavorite {
  customerId String
  productId String
  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([customerId, productId])
}
